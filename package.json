{
  "name": "@gaballahtech/seba",
  "version": "0.5.14",
  "description": "Developer-friendly Solid-OIDC authentication: login, session restoration and DPoP-signed fetch in four methods.",
  "license": "MIT",
  "author": "gaballahtech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaballahtech/seba.git"
  },
  "homepage": "https://github.com/gaballahtech/seba#readme",
  "bugs": {
    "url": "https://github.com/gaballahtech/seba/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "browser": {
    "./dist/node/index.js": false,
    "./dist/node/platform.js": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "browser": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "node": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./pod": {
      "types": "./dist/pod.d.ts",
      "import": "./dist/pod.js",
      "default": "./dist/pod.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "examples/browser",
    "examples/node",
    "examples/react/App.tsx",
    "examples/react/index.html",
    "examples/react/main.tsx",
    "examples/react/vite.config.ts",
    "examples/react/tsconfig.json",
    "examples/react/README.md",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE",
    "RESEARCH.md",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "solid",
    "solid-oidc",
    "oidc",
    "oauth2",
    "dpop",
    "pkce",
    "webid",
    "authentication"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "example:react:build": "vite build --config examples/react/vite.config.ts",
    "validate:discovery": "npm run build && node scripts/validation/public-discovery.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:exports": "npm run build && npx --yes publint@0.3.12"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jose": "^6.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "bin": {
    "seba": "./dist/cli.js"
  }
}
